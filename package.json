{
  "name": "red-dragon-inn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixture": "node scripts/fixture-dev.mjs",
    "dev:cards": "node scripts/card-selection-dev.mjs",
    "dev:fixture:cards": "node scripts/card-selection-dev.mjs --fixture",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "node scripts/require-production.mjs && npm run content:verify:production && npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc -p tsconfig.engine.json && tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/test-projects.mjs",
    "test:watch": "vitest",
    "test:coverage": "node scripts/test-projects.mjs --coverage",
    "test:e2e": "npm run demo:engine && npm run replay:build && playwright test && playwright test --config playwright.dev.config.ts && playwright test --config playwright.rdi1.config.ts",
    "replay:build": "vite build --config vite.replay.config.ts",
    "replay:inspect": "npm run replay:build && node .tools/replay-inspector/replay-inspector.js",
    "demo:engine": "vite build --config vite.engine-demo.config.ts && node .tools/engine-demo/engine-demo.js",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file seeds/0001_sample.sql && wrangler d1 execute DB --local --file seeds/0002_fixture_localized.sql",
    "content:build": "vite build --config vite.content-import.config.ts",
    "content:import": "npm run content:build && node .tools/content-import/content-import.js",
    "content:verify:production": "vite build --config vite.production-content.config.ts && node .tools/production-content/production-content.js",
    "content:verify:rdi1-source": "vite build --config vite.rdi1-source.config.ts && node .tools/rdi1-source/rdi1-source.js",
    "content:compile:rdi1": "vite build --config vite.rdi1-pack.config.ts && node .tools/rdi1-pack/rdi1-pack.js --compile",
    "content:publish:rdi1": "vite build --config vite.rdi1-pack.config.ts && node .tools/rdi1-pack/rdi1-pack.js --publish",
    "content:verify:rdi1": "vite build --config vite.rdi1-pack.config.ts && node .tools/rdi1-pack/rdi1-pack.js",
    "content:coverage:rdi1": "node scripts/rdi1-card-coverage.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "content:translate:zh-TW": "vite build --config vite.localization.config.ts && node .tools/localization/localization.js --translate",
    "content:verify:zh-TW": "vite build --config vite.localization.config.ts && node .tools/localization/localization.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
